# Скопируйте в .env. Файл .env в git не попадает.

# Адрес кнопки «Открыть GET для DEV» из PDF-гайда (стр. 3).
# В ссылке есть подпись sig, поэтому в репозиторий её не коммитим.
CQA_DATASET_URL=

# mock - без ключей и без затрат, llm - настоящая модель (появится в задаче llm/evaluator-core)
CQA_EVALUATOR=mock

ANTHROPIC_API_KEY=
CQA_LLM_MODEL=claude-opus-5-5

# Цена в USD за 1 млн токенов. Нужна для расчёта стоимости оценки в README.
CQA_PRICE_INPUT_PER_MTOK=0
CQA_PRICE_OUTPUT_PER_MTOK=0

CQA_DB_PATH=data/cqa.sqlite3
CQA_CACHE_DIR=data/cache
CQA_BATCH_CONCURRENCY=4
